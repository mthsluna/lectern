{
  "manifest_version": 3,
  "name": "Lectern",
  "short_name": "Lectern",
  "version": "1.20.1",
  "description": "A quiet study timer that blocks distracting sites while you study. Works on its own, or linked to the Lectern app for Windows.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lectern",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "homepage_url": "https://mthsluna.github.io/lectern/",
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
